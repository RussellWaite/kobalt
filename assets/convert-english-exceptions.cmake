# Rebuild whole-word exception weights without changing the general patterns.
file(READ "${CMAKE_CURRENT_LIST_DIR}/../tests/fixtures/hyphenation/ushyphex.tex" corpus)
string(REGEX REPLACE "%[^\n]*" "" corpus "${corpus}")
string(REGEX MATCH "\\hyphenation\{([^}]+)\}" body "${corpus}")
if(NOT body)
    message(FATAL_ERROR "The upstream corpus has no hyphenation list")
endif()
string(REGEX MATCHALL "[A-Za-z-]+" entries "${CMAKE_MATCH_1}")
list(LENGTH entries count)
if(NOT count EQUAL 1753)
    message(FATAL_ERROR "Expected 1753 upstream US English exceptions")
endif()
set(path "${CMAKE_CURRENT_LIST_DIR}/hyph/English_US.pattern")
file(READ "${path}" original)
set(patterns "${original}")
foreach(entry IN LISTS entries)
    string(TOLOWER "${entry}" entry)
    string(REPLACE "-" "9" sparse "${entry}")
    # A high odd weight enables a break. High even weights must also suppress
    # every unlisted break supplied by the general patterns.
    set(dense "")
    set(previous_letter FALSE)
    string(LENGTH "${entry}" length)
    math(EXPR last "${length} - 1")
    foreach(index RANGE ${last})
        string(SUBSTRING "${entry}" ${index} 1 character)
        if(character STREQUAL "-")
            string(APPEND dense "9")
            set(previous_letter FALSE)
        else()
            if(previous_letter)
                string(APPEND dense "8")
            endif()
            string(APPEND dense "${character}")
            set(previous_letter TRUE)
        endif()
    endforeach()
    set(before "<pattern> ${sparse} </pattern>")
    set(after "<pattern> ${dense} </pattern>")
    string(FIND "${patterns}" "${before}" old)
    string(FIND "${patterns}" "${after}" updated)
    if(old EQUAL -1 AND updated EQUAL -1)
        message(FATAL_ERROR "Missing converted exception: ${entry}")
    endif()
    string(REPLACE "${before}" "${after}" patterns "${patterns}")
endforeach()
if(NOT patterns STREQUAL original)
    file(WRITE "${path}" "${patterns}")
endif()
