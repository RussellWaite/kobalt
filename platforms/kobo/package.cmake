set(stage "${CMAKE_CURRENT_BINARY_DIR}/package-stage")
if(QT_MAJOR EQUAL 5)
    set(member "usr/local/Kobo/imageformats")
    set(installer "KoboRoot.tgz")
else()
    set(member "imageformats")
    set(installer "Kobo.tgz")
endif()
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/system/${member}" "${stage}/zip/.kobo" "${stage}/zip/.adds/kobalt")
file(COPY "${LIBRARY}" DESTINATION "${stage}/system/${member}")
execute_process(COMMAND "${STRIP}" "${stage}/system/${member}/libkobalt.so" RESULT_VARIABLE result)
if(result EQUAL 0)
    find_program(KOBALT_TAR NAMES tar REQUIRED)
    execute_process(COMMAND "${KOBALT_TAR}" --format=gnu --owner=0 --group=0 --numeric-owner --mode=0755
        -czf "${stage}/zip/.kobo/${installer}" "${member}/libkobalt.so"
        WORKING_DIRECTORY "${stage}/system" RESULT_VARIABLE result)
endif()
set(members .kobo .adds)
if(result EQUAL 0)
    file(COPY "${ASSETS}/" DESTINATION "${stage}/zip/.adds/kobalt/assets")
    # Books marked for the package go to a library folder. The scenario file
    # and the diagnostics switch go to Kobalt's profile, where the player and
    # the diagnostics log look for them.
    if(EVAL)
        set(scenarios "${ROOT}/platforms/eval/scenarios.json")
        file(READ "${scenarios}" json)
        string(JSON books GET "${json}" books)
        string(JSON count LENGTH "${books}")
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON key MEMBER "${books}" ${index})
            # A device opens only the book a person opened, so other books stay out.
            string(JSON packaged ERROR_VARIABLE unmarked GET "${books}" "${key}" package)
            if(unmarked OR NOT packaged)
                continue()
            endif()
            string(JSON book GET "${books}" "${key}" file)
            string(JSON expected GET "${books}" "${key}" sha256)
            if(NOT EXISTS "${ROOT}/${book}")
                message(FATAL_ERROR "The evaluation book ${key} is missing: ${book}. Build the mac-perf preset once to fetch it.")
            endif()
            file(SHA256 "${ROOT}/${book}" actual)
            if(NOT actual STREQUAL expected)
                message(FATAL_ERROR "The evaluation book ${key} differs from its pinned checksum: ${book}")
            endif()
            file(COPY "${ROOT}/${book}" DESTINATION "${stage}/zip/kobalt-eval")
        endforeach()
        file(COPY "${scenarios}" DESTINATION "${stage}/zip/.adds/kobalt/scenarios")
        file(TOUCH "${stage}/zip/.adds/kobalt/diagnostics-enabled")
        list(APPEND members kobalt-eval)
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT}" --format=zip ${members}
        WORKING_DIRECTORY "${stage}/zip" RESULT_VARIABLE result)
endif()
file(REMOVE_RECURSE "${stage}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Kobo packaging failed: ${result}")
endif()
