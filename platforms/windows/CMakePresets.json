{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-mingw",
      "displayName": "Windows desktop app (MinGW)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/desktop-windows-mingw",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF",
        "CMAKE_C_COMPILER": "D:/dev/Qt/Tools/mingw1310_64/bin/gcc.exe",
        "CMAKE_CXX_COMPILER": "D:/dev/Qt/Tools/mingw1310_64/bin/g++.exe"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows desktop app (MSVC)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../../build/desktop-windows",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-mingw",
      "configurePreset": "windows-mingw",
      "targets": ["Kobalt"],
      "jobs": 2
    },
    {
      "name": "windows-msvc",
      "configurePreset": "windows-msvc",
      "targets": ["Kobalt"],
      "jobs": 2
    }
  ]
}
