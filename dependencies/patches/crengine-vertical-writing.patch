+static int getVerticalInlineEndPadding(ldomNode *enode, RenderRectAccessor fmt)
+{
+    int padding_end = 0;
+    if ( RENDER_RECT_HAS_FLAG(fmt, INNER_FIELDS_SET) ) {
+        padding_end = fmt.getWidth() - fmt.getInnerX() - fmt.getInnerWidth();
+    }
