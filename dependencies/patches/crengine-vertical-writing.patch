+    int rwidth = lengthToPx(enode, style->border_width[1], wpct); if (rwidth==0) rwidth = DEFAULT_BORDER_WIDTH;
+    int bwidth = lengthToPx(enode, style->border_width[2], wpct); if (bwidth==0) bwidth = DEFAULT_BORDER_WIDTH;
