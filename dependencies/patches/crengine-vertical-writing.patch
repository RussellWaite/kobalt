+            m_staticBufs_inUse = false;
+            // printf("releasing static buffers\n");
+        }
+    }
+
+    /// format source data
+    int format()
+    {
+        // split and process all paragraphs
+        splitParagraphs();
+        // cleanup
+        dealloc();
+        TR("format() finished: h=%d  lines=%d", m_line_advance, m_pbuffer->frmlinecount);
+        return m_line_advance;
+    }
