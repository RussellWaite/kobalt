+        case 0x201C: // “
+        case 0x3008: // 〈
+        case 0x300A: // 《
+        case 0x300C: // 「
+        case 0x300E: // 『
+        case 0x3010: // 【
+        case 0x3014: // 〔
+        case 0x3016: // 〖
+        case 0x3018: // 〘
+        case 0x301D: // 〝
