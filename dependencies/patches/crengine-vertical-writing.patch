+        case 0x300F: // 』
+        case 0x3011: // 】
+        case 0x3015: // 〕
+        case 0x3017: // 〗
+        case 0x3019: // 〙
+        case 0x301F: // 〟
+        case 0xFF09: // ）
+        case 0xFF3D: // ］
+        case 0xFF5D: // ｝
