+    {
+        if ( !m_staticBufs ) {
+            free( m_text );
+            free( m_flags );
+            free( m_srcs );
+            free( m_charindex );
+            free( m_advance );
+            m_text = NULL;
+            m_flags = NULL;
+            m_srcs = NULL;
+            m_charindex = NULL;
+            m_advance = NULL;
+            #if (USE_FRIBIDI==1)
